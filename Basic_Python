#7. Countdown Timer
#Ask the user for a number of seconds.
#Print a countdown to zero (just print each number, no actual delay needed yet).
import time, winsound
seconds = int(input("Enter number of secondes: "))
for sec in range(seconds):
    print(f"{sec+1} ")
    winsound.Beep(2000,1000)
    time.sleep(1)
    
