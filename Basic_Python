# 4. String Reverser
#Ask the user for a string.
#Print the string reversed 
def reverse_string(s):
    reversed = ""
    for i in range(len(s)-1,-1,-1):
        reversed += s[i]
    return reversed
word  = input("Enter any string: ")
print(reverse_string(word))
